# Base URL of the AgentFS backend API, baked into the build by Vite.
# Local dev: leave unset (the app defaults to http://127.0.0.1:8000), or copy
# this file to .env.local to override.
# Production: set VITE_API_BASE_URL in your host's environment (e.g. Vercel) to
# the deployed backend URL, with no trailing slash:
#   https://your-backend.up.railway.app
VITE_API_BASE_URL=http://127.0.0.1:8000
